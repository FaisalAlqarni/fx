{
  "description": "fx on Codex: the bootstrap on SessionStart and SubagentStart, and the git guard, lane check and read-only check on PreToolUse. Timeout 30s: a Codex hook that times out fails open (see tests/gates/codex-manifest.test.js).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 30,
            "statusMessage": "Loading fx...",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 30,
            "statusMessage": "Loading fx...",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
