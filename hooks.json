{
  "description": "fx context injection: SessionStart and SubagentStart",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 5,
            "statusMessage": "Loading fx...",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 5,
            "statusMessage": "Loading fx...",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fx-codex.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
