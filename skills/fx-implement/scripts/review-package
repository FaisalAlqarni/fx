#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net diff with
# extended context, written to one file the reviewer reads in a single call.
#
# Why a script and not three git commands: three Bash calls each return their
# output into the controller's context. This returns a path. On a large diff
# that is the difference between a clean coordinator context and a poisoned one.
#
# Using the recorded per-task BASE (never HEAD~1) keeps multi-commit tasks
# intact — HEAD~1 silently drops all but the last commit.
#
# Usage: review-package SLUG BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.fx/<SLUG>/review/<base7>..<head7>.diff
#   Named per range, so a re-review after fixes gets a distinct fresh file.
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package SLUG BASE HEAD [OUTFILE]" >&2
  exit 2
fi

slug=$1
base=$2
head=$3

root=$(git rev-parse --show-toplevel) || { echo "not a git repo" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

# An empty range means the implementer committed nothing. Fail here rather than
# dispatching a reviewer against an empty diff.
if [ -z "$(git rev-list "${base}..${head}")" ]; then
  echo "empty range ${base}..${head}: no commits to review" >&2
  exit 3
fi

if [ $# -eq 4 ]; then
  out=$4
  mkdir -p "$(dirname "$out")"
else
  dir="$root/.fx/$slug/review"
  mkdir -p "$dir"
  out="$dir/$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

# .fx/ holds ephemeral artifacts and must never be committed.
if ! git check-ignore -q "$root/.fx" 2>/dev/null; then
  echo "warning: .fx/ is not git-ignored — add it to .gitignore" >&2
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
