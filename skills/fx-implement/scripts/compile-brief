  for (let i = start + 1; i < lines.length; i++) if (/^\*\*\d+\./.test(lines[i] ?? "") || /^#/.test(lines[i] ?? "")) {
    end = i;
    break;
  }
  return lines.slice(start, end).join("\n").trim();
}
