#!/usr/bin/env python3
"""Install fx for opencode. Claude Code is not required and is never consulted.

Skills, references and the plugin are SYMLINKED: the repo stays the single
source, and `git pull` updates the install. Each skill is linked one at a
time, `skills/<name>`, sitting beside `references/`: `dest/skills` is a real
directory the installer owns, never a whole-folder symlink.

Agents are GENERATED, because the two runtimes disagree on frontmatter:

    Claude Code            opencode
    tools: Read, Grep      permission: { edit: deny, bash: allow }
    (subagent by dir)      mode: subagent

The conversion itself -- which `tools:` become which `permission:` -- has
exactly one implementation, `lib/agent-dialects.js`'s `toOpencodeAgent`. This
installer calls it (via node; see `load_opencode_agents` below) rather than
keeping a second one, so a generated agent file here and the live opencode
plugin's `config.agent[name]` (`plugins/fx.js`) can never compute a different
permission for the same source. Measured against opencode 1.18.25: `write`
and `patch` collapse onto `edit` for permission purposes, and
`tools: { apply_patch: false }` is a silent no-op -- neither is generated.

Commands are GENERATED too, but not because the two runtimes disagree: both
read the file body as the full prompt. Generation exists to normalize the
description field, stamp the generated-file header, name commands and agents
as opencode registers them (`fx-<name>`, with no `fx:` plugin prefix), and
append a final `Arguments, if any: $ARGUMENTS` line.

A skill marked `disable-model-invocation: true` (the user must type it, the
model may never pick it) is generated as a command as well, since opencode has
no way to hide a skill from the model. Such a skill is never linked into
`skills/`. Its body's `../../references/...` and `../../agents/...` citations
are rewritten to absolute paths under the destination, because a generated
command has no skill directory of its own for a relative path to resolve
against.

Generated files carry a header saying they are generated, so nobody edits the
copy and loses it on reinstall.

The installer touches only entries it created. Every refusal fires before the
first write, in a real install and a --dry-run alike: a link at `skills`,
`references`, `plugins/fx.js` or a skill's path that does not point into this
fx checkout; a real entry where one of those links belongs; any link, or any
file without the generated header, at an agent or command path.

    scripts/fx-opencode-install [--dry-run] [--dest <config-dir>]

Destination resolves to $OPENCODE_CONFIG_DIR, else ~/.config/opencode. A fork
that keeps opencode's layout under a different root needs only --dest.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

FX = pathlib.Path(__file__).resolve().parent.parent
GENERATED = "<!-- generated by scripts/fx-opencode-install: edit the source in fx, not this file -->\n"

# A generated command from a user-invoked skill rewrites these citations to
# absolute paths under the destination: either the bare prefix (illustrating
# the convention) or a full path into references/ or agents/.
SKILL_PATH_RE = re.compile(r"`(\.\./\.\./(?:references|agents)/[^`]+|\.\./\.\./)`")

# The skill's sentence saying its `../../` paths resolve from the base
# directory a skill is given. A command is given none, so the sentence is
# replaced whole, before the paths inside it are rewritten.
BASE_DIR_SENTENCE_RE = re.compile(r"Every path below that starts `\.\./\.\./`[^.]*\.")

# Claude Code addresses plugin parts as `fx:fx-<name>`; opencode registers
# the same commands and agents as `fx-<name>`.
PLUGIN_PREFIX_RE = re.compile(r"\bfx:(?=fx-)")


def split_frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        return None, text
    return m.group(1), m.group(2)


def field(fm, key):
    """Read a scalar or a YAML '>' folded block."""
    m = re.search(rf"^{key}:\s*>\s*\n((?:[ \t]+.*\n?)+)", fm, re.M)
    if m:
        return " ".join(l.strip() for l in m.group(1).splitlines() if l.strip())
    m = re.search(rf"^{key}:[ \t]*(.+)$", fm, re.M)
    return m.group(1).strip() if m else None


def yaml_quote(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'


# The node bootstrap that reads fx's agent definitions through the one
# opencode-dialect converter. Mirrors plugins/fx.js's own registration loop
# (`for (const name of READ_ONLY_AGENTS) ... toOpencodeAgent(...)`) exactly,
# so the installer generates the same names from the same canonical set --
# never a bare glob of agents/*.md, which would silently start generating a
# future non-lens agent added there as if it were one of fx's read-only
# roles.
_LOAD_OPENCODE_AGENTS_JS = """
const fs = require('fs');
const path = require('path');
const root = process.argv[1];
const { READ_ONLY_AGENTS } = require(path.join(root, 'lib', 'plant-roles.js'));
const { toOpencodeAgent } = require(path.join(root, 'lib', 'agent-dialects.js'));
const out = {};
for (const name of READ_ONLY_AGENTS) {
  const mdText = fs.readFileSync(path.join(root, 'agents', name + '.md'), 'utf8');
  out[name] = toOpencodeAgent(mdText);
}
process.stdout.write(JSON.stringify(out));
"""


def load_opencode_agents():
    """{name: {mode, description, prompt, permission}}, one entry per
    lib/plant-roles.js's READ_ONLY_AGENTS, computed by the single opencode
    dialect converter (lib/agent-dialects.js). node is not a new runtime
    dependency: hooks/ and plugins/fx.js are already JavaScript that every
    fx install already needs working."""
    result = subprocess.run(["node", "-e", _LOAD_OPENCODE_AGENTS_JS, str(FX)],
                             capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"lib/agent-dialects.js failed to convert an agent: {result.stderr.strip()}")
    return json.loads(result.stdout)


def render_opencode_agent(name, agent):
    """Serialize one `toOpencodeAgent` result as an opencode agent file.
    Pure formatting: every decision about what the agent's permission or
    prompt IS was already made by lib/agent-dialects.js, above."""
    perm = agent["permission"]
    out = ["---", f"description: {yaml_quote(agent['description'])}",
           f"mode: {agent['mode']}",
           "permission:",
           f"  edit: {perm['edit']}",
           f"  bash: {perm['bash']}",
           "---", "", GENERATED]
    return "\n".join(out) + agent["prompt"] + "\n"


def render_command(desc, body):
    """The documented command form: frontmatter with only description, the
    generated header, the body verbatim apart from opencode's names, then the
    final Arguments line. Both runtimes read the body as the prompt, so there
    is no `template:` field."""
    desc, body = (PLUGIN_PREFIX_RE.sub("", s) for s in (desc, body))
    return (f"---\ndescription: {yaml_quote(desc)}\n---\n\n"
            + GENERATED + body.strip("\n") + "\n\nArguments, if any: $ARGUMENTS\n")


def convert_command(path):
    fm, body = split_frontmatter(path.read_text())
    if fm is None:
        return None
    desc = field(fm, "description") or path.stem
    return render_command(desc, body)


def refuse_if_foreign_generated(path):
    """An agent or command path may hold another tool's file, a same-named
    file this installer never wrote, or a link. fx never creates a link
    there, and writing through one, dangling or not, lands outside the
    destination. Never overwrite any of them."""
    if path.is_symlink():
        sys.exit(f"refusing to write through a link fx did not create: {path}")
    if path.exists() and (not path.is_file()
                          or GENERATED not in path.read_text(errors="replace")):
        sys.exit(f"refusing to overwrite a file not generated by this installer: {path}")


def load_skills():
    """Split fx's skills into the ones opencode links (skills/<name>) and the
    ones it generates as a command instead (disable-model-invocation: true).

    A user-invoked skill whose `SKILL.md` is itself generated FROM
    `commands/<name>.md` (task 07's `scripts/gen-command-skills`) is excluded
    here, never linked and never converted a second time: the `commands/*.md`
    loop below already converts its source, at the depth that needs no
    absolute-path rewrite. Converting it again here would both duplicate that
    command and crash `convert_skill_command`'s path resolution on a
    template citation such as `../../references/stacks/<name>.md`, which
    names no real file. Only a hand-written user-invoked skill with no
    source command (`fx-audit`) is converted here."""
    linked, user_invoked = [], []
    for skill_dir in sorted(p for p in (FX / "skills").iterdir() if p.is_dir()):
        skill_md = skill_dir / "SKILL.md"
        if not skill_md.is_file():
            continue
        fm, body = split_frontmatter(skill_md.read_text())
        if fm is None:
            continue
        if (field(fm, "disable-model-invocation") or "").strip() == "true":
            if (FX / "commands" / f"{skill_dir.name}.md").is_file():
                continue
            user_invoked.append((skill_dir, fm, body))
        else:
            linked.append(skill_dir)
    return linked, user_invoked


def convert_skill_command(skill_dir, fm, body, dest_abs):
    desc = field(fm, "description") or skill_dir.name
    missing = []

    def rewrite(m):
        rel = m.group(1)
        tail = rel[len("../../"):]
        # Validated against fx's own tree, not the destination: the
        # destination-relative path is only trustworthy once the sibling
        # symlinks exist, which a --dry-run never creates.
        source = (skill_dir / rel).resolve()
        if not source.exists():
            missing.append(str(source))
        return f"`{dest_abs}/{tail}`" if tail else f"`{dest_abs}`"

    new_body = BASE_DIR_SENTENCE_RE.sub(
        f"Every path below that starts `{dest_abs}` is an absolute path into "
        "the fx install, never into the user's repository.", body)
    new_body = SKILL_PATH_RE.sub(rewrite, new_body)
    if missing:
        sys.exit("rewritten path does not exist: " + ", ".join(missing))
    return render_command(desc, new_body)


FX_SKILLS = FX / "skills"


def points_into_fx(entry, source, inside=False):
    """True when `entry` is a symlink whose recorded target (never resolved,
    so a dangling target still counts) is fx's own `source`, or with
    `inside`, lands anywhere within it. Every link the installer replaces or
    removes passes this first: only a link fx itself could have created is
    touched, and anything else is refused."""
    if not entry.is_symlink():
        return False
    target = os.readlink(entry)
    if not os.path.isabs(target):
        target = str(entry.parent / target)
    target = os.path.normpath(target)
    return target == str(source) or (inside and target.startswith(str(source) + os.sep))


def check_skills_conflicts(skills_dest, linked):
    """Read-only: exits naming the first entry that would stop the install,
    before anything is written. A symlink at skills_dest itself is replaced
    only when it is an earlier install's whole-folder link into fx's
    skills/; nothing inside it needs protecting, since detaching from it
    touches none of its contents. Only once skills_dest is an existing real
    directory do its entries matter."""
    if skills_dest.is_symlink():
        if not points_into_fx(skills_dest, FX_SKILLS):
            sys.exit(f"refusing to replace a link fx did not create: {skills_dest}")
        return
    if skills_dest.exists() and not skills_dest.is_dir():
        sys.exit(f"refusing to replace real file: {skills_dest}")
    if not skills_dest.is_dir():
        return
    for skill_dir in linked:
        dst = skills_dest / skill_dir.name
        if dst.is_symlink():
            if not points_into_fx(dst, FX_SKILLS, inside=True):
                sys.exit(f"refusing to replace a link fx did not create: {dst}")
        elif dst.exists():
            sys.exit(f"refusing to replace real entry with fx skill's name: {dst}")


def check_link_conflicts(links):
    """Read-only: `references` and `plugins/fx.js` are replaced only when
    they already are fx's own links. Any other link, or a real entry, stops
    the install before anything is written."""
    for src, dst in links:
        if dst.is_symlink():
            if not points_into_fx(dst, src):
                sys.exit(f"refusing to replace a link fx did not create: {dst}")
        elif dst.exists():
            sys.exit(f"refusing to replace real file/dir: {dst}")


def warn_duplicate_pool(skills_dest, linked):
    """opencode reads `~/.agents/skills` in addition to whatever pool
    `--dest`'s `skills/` resolves to (measured against 1.18.25). A user who
    already has fx symlinked into both has a working install today, so
    finding fx in the second pool WARNS, naming both pools and the
    remediation, and never refuses: a refusal here would break an install
    that works. Read-only: called from the checks phase, before any write."""
    other = pathlib.Path(os.path.expanduser("~/.agents/skills"))
    if os.path.abspath(str(other)) == os.path.abspath(str(skills_dest)):
        return  # --dest IS the other pool; there is only one to warn about
    for skill_dir in linked:
        if (other / skill_dir.name).exists():
            print(f"warning: {skill_dir.name} is already installed in {other}, "
                  f"as well as {skills_dest}. opencode loads skills from both "
                  "pools, so remove the stale copy in whichever one you no "
                  "longer use.")


def check_directories(dirs):
    """Read-only: every directory the installer creates or writes into must
    be a directory, or absent. A file or a dangling link there would stop
    the install partway, after earlier writes."""
    for d in dirs:
        if (d.exists() or d.is_symlink()) and not d.is_dir():
            sys.exit(f"refusing to replace a non-directory where fx needs a directory: {d}")


def link_skills(dest, linked, args):
    """dest/skills is a real directory the installer owns. Each linked skill
    gets its own symlink beside it. A whole-folder link from an older install
    is unlinked, never recursed into. Only symlinks pointing into fx's own
    skills/ are cleaned up; anything else there, another tool's skill, is
    untouched. Every refusal already fired in check_skills_conflicts, before
    this runs, so nothing here needs to re-check or exit."""
    skills_dest = dest / "skills"
    act = "would " if args.dry_run else ""
    print(f"{act}ensure {skills_dest} is a real directory")
    if not args.dry_run:
        if skills_dest.is_symlink():
            skills_dest.unlink()
        skills_dest.mkdir(parents=True, exist_ok=True)

        for entry in skills_dest.iterdir():
            if points_into_fx(entry, FX_SKILLS, inside=True):
                entry.unlink()

    for skill_dir in linked:
        dst = skills_dest / skill_dir.name
        print(f"{act}link {dst} -> {skill_dir}")
        if args.dry_run:
            continue
        dst.symlink_to(skill_dir, target_is_directory=True)


def merge_opencode_json(dest, args):
    """fx's only owned key in the user's `opencode.json` is `subagent_depth`:
    the shipped binary enforces `subagent_depth ?? 1` (references/harnesses/
    opencode.md), which caps a dispatched implementer at zero nested
    subagent calls -- no reviewer from an implementer -- until it is raised.
    Every other key the user already had survives unchanged: this MERGES,
    it never rewrites the file wholesale, and never lowers a value already
    set higher than fx needs. Idempotent: a run that finds the key already
    at or above 2 writes nothing, so a second install produces the same
    bytes as the first."""
    config_path = dest / "opencode.json"
    try:
        raw = config_path.read_text()
    except FileNotFoundError:
        data = {}
    else:
        try:
            data = json.loads(raw)
        except json.JSONDecodeError as e:
            sys.exit(f"{config_path} is not valid JSON: {e}")
        if not isinstance(data, dict):
            sys.exit(f"{config_path} does not hold a JSON object at its top level")

    current = data.get("subagent_depth")
    target = max(current, 2) if isinstance(current, int) else 2
    if current == target:
        return

    act = "would " if args.dry_run else ""
    print(f"{act}set {config_path} subagent_depth = {target} (was {current!r})")
    if args.dry_run:
        return
    data["subagent_depth"] = target
    dest.mkdir(parents=True, exist_ok=True)
    config_path.write_text(json.dumps(data, indent=2) + "\n")


def main():
    ap = argparse.ArgumentParser(
        description="Install fx for opencode. Every write stays inside "
        "--dest: skills, references and the plugin are symlinked; agents "
        "and commands are generated. The one exception is opencode.json, "
        "which this installer MERGES, never rewrites wholesale -- it only "
        "ever sets its own subagent_depth key, raising it to at least 2 if "
        "needed, and leaves every key already there untouched.")
    # A fork may relocate the config root. opencode itself honours
    # OPENCODE_CONFIG_DIR, so follow it before falling back to the default.
    default_dest = os.environ.get("OPENCODE_CONFIG_DIR") or os.path.expanduser("~/.config/opencode")
    ap.add_argument("--dest", default=default_dest,
                     help="opencode config directory to install into "
                     "(default: $OPENCODE_CONFIG_DIR or ~/.config/opencode)")
    ap.add_argument("--dry-run", action="store_true",
                     help="print exactly what a real run would do; write nothing")
    args = ap.parse_args()
    dest = pathlib.Path(args.dest)
    act = "would " if args.dry_run else ""

    linked, user_invoked = load_skills()
    # opencode scans both `skill/` and `skills/`, and both `command/` and
    # `commands/` (measured against 1.18.25); the plural spelling below is
    # the one fx picks and keeps, not a gap.
    skills_dest = dest / "skills"
    agents_out = dest / "agents"
    commands_out = dest / "commands"
    dest_abs = pathlib.Path(os.path.abspath(str(dest)))
    # references and the plugin stay whole-file symlinks, as today
    links = [
        (FX / "references", dest / "references"),
        (FX / "plugins" / "fx.js", dest / "plugins" / "fx.js"),
    ]

    # ---- checks: every refusal fires here, before anything is written, in
    # both a real install and a --dry-run. Generating each agent's and
    # command's text is read-only (it only reads fx's own source tree), so it
    # runs here too: convert_skill_command is where the "rewritten path does
    # not exist" check lives, and doing it now means a missing path is caught
    # before any write, not partway through one. ----
    check_directories([dest, dest / "plugins", agents_out, commands_out])
    check_skills_conflicts(skills_dest, linked)
    check_link_conflicts(links)
    warn_duplicate_pool(skills_dest, linked)

    generated = []
    opencode_agents = load_opencode_agents()
    for name, agent in opencode_agents.items():
        text = render_opencode_agent(name, agent)
        refuse_if_foreign_generated(agents_out / f"{name}.md")
        generated.append((agents_out / f"{name}.md", text))
    agent_count = len(opencode_agents)
    for src in sorted((FX / "commands").glob("*.md")):
        text = convert_command(src)
        if text is None:
            print(f"  skip {src.name} (no frontmatter)")
            continue
        refuse_if_foreign_generated(commands_out / src.name)
        generated.append((commands_out / src.name, text))
    for skill_dir, fm, body in user_invoked:
        text = convert_skill_command(skill_dir, fm, body, dest_abs)
        out_path = commands_out / f"{skill_dir.name}.md"
        refuse_if_foreign_generated(out_path)
        generated.append((out_path, text))

    # ---- writes (or, under --dry-run, only the printed report): every
    # check above has already passed, so nothing from here on refuses. ----

    # 1. skills, linked one at a time
    link_skills(dest, linked, args)

    # 2. references and the plugin: an existing link here is fx's own
    for src, dst in links:
        print(f"{act}link {dst} -> {src}")
        if args.dry_run:
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.is_symlink():
            dst.unlink()
        dst.symlink_to(src, target_is_directory=src.is_dir())

    # 3. generated agents, then commands: one per commands/*.md, one per
    # user-invoked skill
    for out_path, text in generated:
        print(f"{act}write {out_path}")
        if args.dry_run:
            continue
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(text)

    # 4. subagent_depth: the one key fx owns in the user's opencode.json
    merge_opencode_json(dest, args)

    if args.dry_run:
        print("\ndry run: nothing written")
        return

    # 5. verify the thing that silently breaks, by both routes: through a
    # linked skill, and through the destination's own references entry
    probes = [
        dest / "skills" / "fx-tdd" / ".." / ".." / "references" / "vocab" / "good-tests.md",
        dest / "references" / "vocab" / "good-tests.md",
    ]
    ok = all(p.exists() for p in probes)
    print(f"\nreference resolution through the symlinked tree: {'OK' if ok else 'BROKEN'}")
    if not ok:
        sys.exit("references did not resolve: skills and references must be siblings")
    fx_links = sum(1 for e in skills_dest.iterdir() if points_into_fx(e, FX_SKILLS, inside=True))
    print(f"skills: {fx_links}  agents: {agent_count}  "
          f"commands: {len(generated) - agent_count}")


if __name__ == "__main__":
    main()
