#!/usr/bin/env python3
"""Grep the prose rules that were previously enforced by nobody.

Every other invariant in fx has a gate: check-paths, check-reference-leaves,
check-manifest, three guard suites. Prose had none, so it was the only rule
that failed silently and everywhere. The em-dash count across fx's own files
was 272 lines while PREAMBLE.md told everyone not to do it.

An unmeasurable rule is one nobody checks. This makes it measurable.

    scripts/check-prose [path ...]      default: the whole plugin
    scripts/check-prose --diff <ref>    the lines added since <ref> in the
                                        current repository, untracked files
                                        included: HEAD for a task's uncommitted
                                        work, the merge-base for a branch

Markdown is read outside fenced code. Any other file is read only in its
comments (# // /* */ <!-- --> and Python docstrings), so a string or an
identifier in code never fires. Each hit prints `file:line: pattern: excerpt`
and the exit status is 1. The patterns are the part of fx-humanize's catalogue
a regex finds with few false positives; the rest stays fx-humanize's job.

Upstream files are exempt: fx-humanize is carried from upstream and
rearranged (fx's added lines are listed in its COVERAGE.md), and
references/testing/ holds upstream pressure scenarios. Changing them would
be a local modification we deliberately do not carry.
"""
import os
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
EXEMPT = ('skills/fx-humanize/', 'references/testing/', 'upstream/', '.git/',
          '.fx/', 'scripts/check-prose', 'lib/fix-dashes.test.py',
          # Its fixtures are strings that hold every tell in every comment syntax.
          'gates/check-prose-humanize.test.',
          # Nested worktrees hold other branches' files, which this checkout's
          # gate does not own.
          '.worktrees/',
          # `.claude/` is this checkout's own configuration, not fx's shipped
          # prose. `.claude/CLAUDE.md` is tracked and it is written by an
          # indexer, which rewrites it on every reindex: its dashes belong to
          # that tool and no edit of ours survives the next run. The rest of
          # the directory is local settings and nested worktrees, which this
          # checkout's gate does not own either.
          '.claude/',
          # Anthropic's own skill-authoring guide, carried verbatim. Editing its
          # prose would make it a local fork of a document whose value is that
          # it is not one.
          'skills/fx-authoring/anthropic-best-practices.md')
# Directories a walk never enters: dependencies and version control.
PRUNE = {'.git', 'node_modules'}

# Stock AI vocabulary. Word-boundary matched so "delved" and "leverage" in a
# code identifier do not fire.
# `leverage` is listed in its VERB forms only. fx uses the noun as a term of
# art: `references/vocab/codebase-design.md` defines "leverage at the interface"
# alongside module, depth and seam, and "the highest-leverage text in the plugin"
# is ordinary English. The stock-AI tell is the verb ("leveraging X to Y"), and
# banning the noun flagged twelve correct uses of fx's own vocabulary.
STOCK = ['delve', 'leveraging', 'leverages', 'leveraged',
         'seamless', 'robust', 'comprehensive', 'crucial',
         'utilize', 'pivotal', 'in the realm of',
         'tapestry', 'meticulous', 'meticulously', 'intricate', 'intricacies',
         'interplay', 'garner', 'garnered', 'bolstered', 'vibrant',
         'showcase', 'showcases', 'showcasing', 'deep dive']
HEDGE = ["it's not just", 'it is not just', "isn't just", 'not only that']
# fx-humanize §4, §13 and §22: phrases that are tells wherever they stand.
FILLER = ["let's dive in", "let's dive into", "let's explore", "let's break this down",
          "let's break it down", "here's what you need to know", 'without further ado',
          "here's the thing", "let's be honest", 'real talk', "it's worth noting",
          'it is worth noting', 'it is important to note', "it's important to note",
          'needless to say', "in today's fast-paced"]
INFLATED = ['stands as a testament', 'serves as a testament', 'testament to',
            'plays a crucial role', 'plays a vital role', 'plays a pivotal role',
            'plays a key role', 'setting the stage for', 'sets the stage for',
            'evolving landscape', 'ever-evolving', 'indelible mark', 'enduring legacy',
            'lasting legacy', 'the future looks bright', 'exciting times ahead',
            'a step in the right direction', 'game-changer', 'game changer']
CHATBOT = ['i hope this helps', 'great question', 'certainly!', 'of course!',
           "you're absolutely right", 'let me know if', 'feel free to', 'happy to help',
           'as an ai', 'as a large language model', 'my last training',
           'my knowledge cutoff', 'would you like me to']


def _words(label, words):
    return [(label, re.compile(rf'(?<!\w){re.escape(w)}(?!\w)')) for w in words]


# fx-humanize §1, kept to the staged form where both halves are short noun
# phrases and the second ends the sentence: "not a bug, but a feature." Any
# "not X, but Y" flagged 31 honest contrasts in fx's own review records ("not
# a defect, but a future change must be made twice") and caught one tell.
PATTERNS = (_words('stock word', STOCK) + _words('not X but Y', HEDGE)
            + [('not X but Y', re.compile(r"\bnot (?:just |only |merely )?(?:a|an|the) [\w-]+(?: [\w-]+){0,3}, "
                                          r"but (?:a|an|the|rather|also) [\w-]+(?: [\w-]+){0,2}[.!\"')]")),
               # Two characters at least: "it's not X, it's Y" with a one-letter
               # placeholder states the rule, as PREAMBLE.md does, and is not prose.
               ('not X but Y', re.compile(r"\b(?:it|this|that)(?:'s| is) not [^.;!?]{2,40}?[,;] "
                                          r"(?:it|this|that)(?:'s| is)\b"))]
            + _words('filler opener', FILLER) + _words('inflated phrase', INFLATED)
            + _words('chatbot artifact', CHATBOT))


def hits(line):
    """(pattern, excerpt) for each tell on one line of prose."""
    low = line.lower().replace('’', "'")
    out = [('dash', line.strip())] if '—' in line or '–' in line else []
    return out, [(label, line.strip()) for label, rx in PATTERNS if rx.search(low)]


# Comment syntax per file kind. A `#` or `//` opens a comment only at the start
# of a line or after whitespace, so `https://` and `"#fff"` stay code.
HASH = {'.rb', '.rake', '.py', '.sh', '.bash', '.yml', '.yaml', '.toml'}
SLASH = {'.js', '.mjs', '.cjs', '.jsx', '.ts', '.tsx', '.cs', '.css', '.scss',
         '.kt', '.swift', '.go', '.java'}
MARKUP = {'.html', '.htm', '.erb', '.cshtml', '.razor', '.vue', '.svelte'}
HASH_NAMES = {'Dockerfile', 'Gemfile', 'Rakefile'}


def kind(p, text):
    ext = p.suffix.lower()
    if ext in ('.md', '.markdown'):
        return 'md'
    if ext in HASH or p.name in HASH_NAMES or p.name.startswith('Dockerfile'):
        return 'py' if ext == '.py' else 'hash'
    if ext in SLASH:
        return 'slash'
    if ext in MARKUP:
        return 'markup'
    first = text.split('\n', 1)[0]
    if not ext and first.startswith('#!'):
        return 'slash' if 'node' in first else ('py' if 'python' in first else 'hash')
    return None


def comments(text, k):
    """Yield (line number, comment text) for every comment line of a code file."""
    line_tok = {'hash': '#', 'py': '#', 'slash': '//'}.get(k)
    opens = {'slash': [('/*', '*/')], 'markup': [('<!--', '-->')],
             'py': [('"""', '"""'), ("'''", "'''")]}.get(k, [])
    end = None
    for n, line in enumerate(text.splitlines(), 1):
        rest, out = line, []
        while rest:
            if end:
                i = rest.find(end)
                out.append(rest if i < 0 else rest[:i])
                if i < 0:
                    break
                rest, end = rest[i + len(end):], None
                continue
            cands = []
            if line_tok:
                m = re.search(rf'(?:^|(?<=\s)){re.escape(line_tok)}', rest)
                if m:
                    cands.append((m.start(), line_tok, None))
            for o, e in opens:
                # A docstring opens a statement; a quote mid-line is a string.
                if k == 'py' and not rest.lstrip().lstrip('rbuRBU').startswith(o):
                    continue
                i = rest.find(o)
                if i >= 0:
                    cands.append((i, o, e))
            if not cands:
                break
            i, tok, e = min(cands)
            if e is None:
                out.append(rest[i + len(tok):])
                break
            rest, end = rest[i + len(tok):], e
        text_out = ' '.join(s for s in out if s.strip())
        if text_out:
            yield n, text_out


def markdown_lines(text):
    """Yield (line number, line) for Markdown outside fenced code."""
    infence = False
    for n, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith('```'):
            infence = code_fence(line) if not infence else False
            continue
        if not infence:
            yield n, line


def diff_targets(ref):
    """(path, rel, added line numbers or None for all) for what changed since ref."""
    import subprocess
    git = lambda *a: subprocess.run(['git', *a], capture_output=True, text=True, check=True).stdout
    top = pathlib.Path(git('rev-parse', '--show-toplevel').strip())
    added, cur = {}, None
    for line in git('-C', str(top), 'diff', '-U0', '--no-renames', '--no-color', ref).splitlines():
        if line.startswith('+++ '):
            cur = line[6:] if line.startswith('+++ b/') else None
        elif line.startswith('@@') and cur:
            m = re.match(r'@@ -\S+ \+(\d+)(?:,(\d+))? @@', line)
            start, count = int(m.group(1)), int(m.group(2) if m.group(2) is not None else 1)
            added.setdefault(cur, set()).update(range(start, start + count))
    for rel in git('-C', str(top), 'ls-files', '--others', '--exclude-standard').splitlines():
        added[rel] = None
    for rel in sorted(added):
        p = top / rel
        if p.is_file() and not any(e in rel for e in EXEMPT):
            yield p, rel, added[rel]

# A block that quotes this list on purpose (to state the rule, not break it)
# carries this marker and is exempt. Nothing else is: three earlier attempts
# tried to INFER "mention versus use" from formatting (a per-line density
# threshold, then a paragraph-wide version of it, then masking backtick
# spans), and each was correct for the case that motivated it and wrong just
# outside it. Formatting does not carry that distinction; only the author
# does. Same call this codebase already made twice: fenced blocks are tagged
# ```markdown rather than sniffed, and `scripts/check-artifacts` uses
# `artifact-gate: ok` rather than an allowlist (ADR 0011). Declared at the
# site, checked by presence, nothing inferred.
MARKER = 'prose-gate: quoting'


def files(paths):
    for base in (paths or [ROOT]):
        base = pathlib.Path(base)
        if base.is_file():
            # Named explicitly on the command line: always read. The exemption
            # list exists to keep a whole-repository walk out of upstream and
            # nested-worktree files, not to let a caller who names a file
            # under one of those paths on purpose be ignored.
            rel = str(base.relative_to(ROOT)) if base.is_relative_to(ROOT) else str(base)
            yield base, rel
            continue
        # Every file, Markdown and code alike: main() reads a code file's
        # comments only and skips a file of no known kind.
        for d, dirs, names in os.walk(base):
            dirs[:] = sorted(x for x in dirs if x not in PRUNE)
            for name in sorted(names):
                p = pathlib.Path(d, name)
                rel = str(p.relative_to(ROOT)) if p.is_relative_to(ROOT) else str(p)
                if not any(e in rel for e in EXEMPT):
                    yield p, rel


# A fenced block is exempt only when it holds code. Most fences in this
# repository hold neither code nor sample output: they hold the prompt text a
# dispatched subagent reads as its instructions, which is the highest-leverage
# prose here and was the only prose the checker never read.
#
# Prose fences are tagged ```markdown rather than inferred. A bare fence stays
# code, because it routinely is: `lib/fix-dashes.test.py` pins the case where
# guessing rewrote `let x = a - b` inside one. Tagging says which fences are
# text at the site, where the person adding one can see the rule.
FENCE_TICKS = re.compile(r'^(\s*)(`{3,})(.*)$')
OPTION_LABEL = re.compile(r'^\s*[A-Za-z0-9]\)', re.M)
FENCE_LANG = re.compile(r'^\s*```+\s*`*([A-Za-z0-9_+#.-]*)')


def code_fence(line):
    """True when this fence opener starts a block of code rather than prose."""
    m = FENCE_LANG.match(line)
    lang = (m.group(1) if m else '').lower()
    return lang not in ('markdown', 'md')


def nested_fence_defects(text):
    """Language-tagged closing fences in the literal content of an outer block.

    A template wrapped in a ````four-tick```` fence holds ```three-tick``` fences
    as literal text. They are content, not structure, so markdown parses the file
    happily and every fence-aware check stays green while the template teaches a
    broken closer. Retagging prose fences in bulk produced exactly this: two
    closers inside `fx-plan`'s task template became ```markdown, and the only
    reader that would ever notice is a human copying the template.
    """
    out, outer, inner = [], None, None
    for n, line in enumerate(text.splitlines(), 1):
        m = FENCE_TICKS.match(line)
        if not m:
            continue
        ticks, info = len(m.group(2)), m.group(3).strip()
        if outer is None:
            outer = ticks
            continue
        if ticks >= outer and not info:
            outer = inner = None
            continue
        if inner is None:
            inner = ticks
        elif ticks >= inner:
            if info:
                out.append((n, line.strip()))
            inner = None
    return out


def blocks(text):
    """Yield (first-line-number, text) for each paragraph outside fenced code.

    Paragraph, not line: markdown wraps sentences, so a legitimate parenthesis
    routinely opens on one line and closes on the next. Only a whole block that
    fails to close indicates real damage.
    """
    infence = False
    buf, start = [], 1
    for n, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith('```'):
            # A fence ends the paragraph before it, as it does when rendered.
            # Merged across one, prose on both sides shared a single marker and
            # a single parenthesis count, and main() maps a block back onto
            # physical lines by its line count, which holds only for a
            # contiguous run.
            if buf:
                yield start, '\n'.join(buf)
                buf = []
            infence = code_fence(line) if not infence else False
            continue
        if infence:
            continue
        if line.strip():
            if not buf:
                start = n
            buf.append(line)
        elif buf:
            yield start, '\n'.join(buf)
            buf = []
    if buf:
        yield start, '\n'.join(buf)


def targets(argv):
    """(path, rel, line filter) for each file to read; a filter of None reads every line."""
    if argv[:1] == ['--diff']:
        if len(argv) != 2:
            sys.exit('usage: check-prose --diff <ref>')
        yield from diff_targets(argv[1])
        return
    for p, rel in files([a for a in argv if not a.startswith('--')]):
        yield p, rel, None


def main():
    counts, report = {}, []
    exempted_blocks = 0

    def add(rel, n, pattern, excerpt, only):
        if only is None or n in only:
            counts[pattern] = counts.get(pattern, 0) + 1
            report.append(f'{rel}:{n}: {pattern}: {excerpt[:100]}')

    for p, rel, only in targets(sys.argv[1:]):
        try:
            text = p.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        k = kind(p, text)
        if k is None:
            continue
        marked_lines = set()
        if k == 'md':
            # A block whose parentheses do not close is almost always this
            # script's parens, and a pairing rule that guesses wrong leaves one
            # of each in different places. Counting dashes cannot see it,
            # because the broken output has no dashes left in it. DEBT #37.
            # A lettered or numbered option label ("A)", "3)") is a list marker,
            # not half a pair. Prompt templates offering a choice are full of them.
            for n, line in nested_fence_defects(text):
                add(rel, n, 'closing fence carries a language', line, only)
            # The marker exempts every physical line of the block it sits in,
            # because a quoted list wraps across lines like anything else in
            # markdown, and nothing else: a violation sharing a paragraph with
            # an unmarked block is still caught.
            for start, block in blocks(text):
                body = OPTION_LABEL.sub('', block)
                if body.count('(') != body.count(')'):
                    add(rel, start, 'unclosed parenthesis', block.splitlines()[0].strip(), only)
                if MARKER in block:
                    exempted_blocks += 1
                    marked_lines.update(range(start, start + len(block.splitlines())))
            # A dash in a sample command, a tree diagram or an output template is
            # part of the example, so fenced code is not read.
            lines = markdown_lines(text)
        else:
            lines = comments(text, k)
            if MARKER in text:
                marked_lines = {n for n, line in enumerate(text.splitlines(), 1) if MARKER in line}
        for n, line in lines:
            dashes, found = hits(line)
            for pattern, excerpt in dashes + ([] if n in marked_lines else found):
                add(rel, n, pattern, excerpt, only)

    print(f'{exempted_blocks} block(s) exempted by `{MARKER}`')

    if not report:
        print('OK: no dashes, no stock vocabulary or staged phrasing, parentheses balanced')
        return 0

    print('FAIL: ' + ', '.join(f'{v} {k}' for k, v in sorted(counts.items())))
    for r in report[:60]:
        print(r)
    if len(report) > 60:
        print(f'  ... and {len(report) - 60} more')
    print(f'Quoting the rule on purpose? Add `{MARKER}` anywhere in that '
          f'paragraph, or on that comment line. Everything else is a judgement '
          f'call and stays yours: fx-humanize rewrites what a regex only finds.')
    return 1


if __name__ == '__main__':
    sys.exit(main())
