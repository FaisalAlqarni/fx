#!/usr/bin/env python3
"""Task 01's gate. Two failures, both silent in production:

  1. An unanchored `references/...` path. Once fx is installed, the session's
     cwd is the USER'S repo, so a bare path resolves there, finds nothing, and
     the lane carries on without the reference. Nothing errors.
  2. A cited reference that does not exist. Same silence.

Paths are anchored relative to the citing file, which resolves on any runtime
and needs no environment variable.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
if "--root" in sys.argv:
    ROOT = pathlib.Path(sys.argv[sys.argv.index("--root") + 1]).resolve()

LINK = re.compile(r'\[[^\]]*\]\(([^)\s]+)\)')
# Unreachable today; the named task adds the link and deletes the entry.
PENDING_ORPHANS = {
    'skills/fx-authoring/anthropic-best-practices.md': '04',
    'skills/fx-implement/re-review-prompt.md': '16',
}
# Its links are examples, carried verbatim.
NOT_A_SOURCE = {'skills/fx-authoring/anthropic-best-practices.md'}
BARE = re.compile(r'`references/[A-Za-z0-9/._-]+`')
ANCHORED = re.compile(r'`((?:\.\./)+references/[A-Za-z0-9/._-]+)`')

failures = []
checked = 0

# references/ included: a reference names plugin paths too, anchored relative
# to itself, and an agent follows them from the same user's repo.
for area in ("skills", "agents", "commands", "references"):
    for path in sorted((ROOT / area).rglob("*.md")):
        text = path.read_text()
        rel = path.relative_to(ROOT)

        for bad in BARE.findall(text):
            failures.append(f"{rel}: unanchored {bad}")

        for ref in ANCHORED.findall(text):
            checked += 1
            if not (path.parent / ref).resolve().exists():
                failures.append(f"{rel}: cites {ref} -> no such file")

# Markdown links inside each lane: they resolve, and every file is named by one.
for lane in sorted(p for p in (ROOT / "skills").glob("*") if p.is_dir()):
    named = set()
    for path in sorted(lane.rglob("*.md")):
        rel = path.relative_to(ROOT).as_posix()
        if rel in NOT_A_SOURCE:
            continue
        for target in LINK.findall(path.read_text()):
            if re.match(r'[A-Za-z][A-Za-z0-9+.-]*:', target) or target.startswith('#'):
                continue
            resolved = (path.parent / target.split('#')[0]).resolve()
            checked += 1
            if not resolved.is_file():
                failures.append(f"{rel}: link {target} -> no such file")
            elif path.name != "COVERAGE.md" and resolved != path.resolve():
                named.add(resolved)
    for path in sorted(lane.rglob("*.md")):
        rel = path.relative_to(ROOT).as_posix()
        if path.name in ("SKILL.md", "COVERAGE.md") or path.resolve() in named:
            continue
        if rel in PENDING_ORPHANS:
            continue
        failures.append(f"{rel}: no link from another file in skills/{lane.name}/ reaches it")
if failures:
    print(f"FAIL: {len(failures)} problem(s)")
    for f in failures:
        print(f"  {f}")
    sys.exit(1)

print(f"OK: {checked} reference citations, all anchored and resolvable")
