#!/usr/bin/env python3
"""Task 01's gate. Two failures, both silent in production:

  1. An unanchored `references/...` path. Once fx is installed, the session's
     cwd is the USER'S repo, so a bare path resolves there, finds nothing, and
     the lane carries on without the reference. Nothing errors.
  2. A cited reference that does not exist. Same silence.

Paths are anchored relative to the citing file, which resolves on any runtime
and needs no environment variable.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
BARE = re.compile(r'`references/[A-Za-z0-9/._-]+`')
ANCHORED = re.compile(r'`((?:\.\./)+references/[A-Za-z0-9/._-]+)`')

failures = []
checked = 0

for area in ("skills", "agents", "commands"):
    for path in sorted((ROOT / area).rglob("*.md")):
        text = path.read_text()
        rel = path.relative_to(ROOT)

        for bad in BARE.findall(text):
            failures.append(f"{rel}: unanchored {bad}")

        for ref in ANCHORED.findall(text):
            checked += 1
            if not (path.parent / ref).resolve().exists():
                failures.append(f"{rel}: cites {ref} -> no such file")

if failures:
    print(f"FAIL: {len(failures)} problem(s)")
    for f in failures:
        print(f"  {f}")
    sys.exit(1)

print(f"OK: {checked} reference citations, all anchored and resolvable")
