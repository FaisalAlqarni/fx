#!/usr/bin/env python3
"""Generate Codex role files for fx's read-only review agents.

    scripts/gen-codex-agents [output-dir]      default: codex/agents

A Claude Code agent definition under `agents/*.md` is read-only when its
frontmatter `tools:` line grants none of Claude Code's write tools (`Write`,
`Edit`, `MultiEdit`, `NotebookEdit`). That set is derived here, never
hardcoded and never matched by a `fx-lens-` prefix: `fx-devils-advocate`
carries the same restriction for the same reason and must be generated too
(task 06).

Each match becomes one `<name>.toml` Codex role file: `name`, `description`
and `sandbox_mode = "read-only"` from the frontmatter, `developer_instructions`
from the body, verbatim. `sandbox_mode` is declared intent, not enforcement —
docs/adr/0019-read-only-is-three-mechanisms-and-one-guarantee.md measured
that a role file alone does not stop a write; `lib/plant-roles.js` and the
PreToolUse hook are the enforcement. The header says so.

Idempotent: running this twice produces byte-identical output, which is what
`scripts/check-generated` verifies by regenerating into a temp directory and
diffing it against the committed `codex/agents/`.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
AGENTS = ROOT / "agents"

WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}

HEADER = (
    "# generated by scripts/gen-codex-agents from {source}: edit there, not here.\n"
    "# sandbox_mode below is declared intent (the Codex docs ask for it); it does\n"
    "# NOT enforce read-only. Enforcement is lib/plant-roles.js + the PreToolUse\n"
    "# hook. See docs/adr/0019-read-only-is-three-mechanisms-and-one-guarantee.md.\n"
)


def split_frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        sys.exit("no frontmatter found")
    return m.group(1), m.group(2)


def field(fm, key):
    """Read a scalar or a YAML '>' folded block."""
    m = re.search(rf"^{key}:\s*>\s*\n((?:[ \t]+.*\n?)+)", fm, re.M)
    if m:
        return " ".join(l.strip() for l in m.group(1).splitlines() if l.strip())
    m = re.search(rf"^{key}:[ \t]*(.+)$", fm, re.M)
    return m.group(1).strip() if m else None


def is_read_only(fm):
    tools = field(fm, "tools") or ""
    granted = {t.strip() for t in tools.split(",") if t.strip()}
    return bool(granted) and granted.isdisjoint(WRITE_TOOLS)


def toml_escape(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')


def toml_body(body):
    body = body.strip("\n").replace("\\", "\\\\")
    if '"""' in body:
        sys.exit('agent body contains a literal """, which breaks a TOML '
                  "triple-quoted string: rewrite the source body")
    return body


def role_toml(name, source, description, body):
    return (
        HEADER.format(source=source)
        + "\n"
        + f'name = "{toml_escape(name)}"\n'
        + f'description = "{toml_escape(description)}"\n'
        + 'sandbox_mode = "read-only"\n'
        + "\n"
        + 'developer_instructions = """\n'
        + toml_body(body)
        + '\n"""\n'
    )


def main():
    out_dir = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "codex" / "agents"
    out_dir.mkdir(parents=True, exist_ok=True)

    generated = []
    for path in sorted(AGENTS.glob("*.md")):
        fm, body = split_frontmatter(path.read_text())
        if not is_read_only(fm):
            continue
        name = field(fm, "name") or path.stem
        description = field(fm, "description") or name
        source = f"agents/{path.name}"
        out = out_dir / f"{name}.toml"
        out.write_text(role_toml(name, source, description, body))
        generated.append(out)
        print(f"wrote {out}")

    if len(generated) < 2:
        sys.exit(f"expected at least the lenses and the devil's advocate; got {len(generated)}")


if __name__ == "__main__":
    main()
