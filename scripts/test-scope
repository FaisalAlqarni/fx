#!/usr/bin/env node
'use strict';
// Builds the command list for the tests and gates a task's changed paths
// require, then runs them in order, stopping at the first failure.
//
//     scripts/test-scope [--dry-run] <path>...
//
// See docs/plans/2026-09-23-lean-build/tasks/12-scoped-tests-this-repo.md for
// the rule table this implements.
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const ROOT = path.join(__dirname, '..');
const LAST = 'node tests/gates/release-version.test.js';

function allGateCommands() {
  return fs.readdirSync(path.join(ROOT, 'tests', 'gates'))
    .filter((f) => f.endsWith('.test.js'))
    .sort()
    .map((f) => `node tests/gates/${f}`);
}

// First matching rule wins, in the order the task specifies.
function commandsFor(p) {
  if (!fs.existsSync(path.join(ROOT, p))) return [];
  if (p.endsWith('.test.js')) return [`node ${p}`];
  if (p.endsWith('.js')) {
    const sibling = `${p.slice(0, -'.js'.length)}.test.js`;
    if (fs.existsSync(path.join(ROOT, sibling))) return [`node ${sibling}`];
  }
  if (p.endsWith('.test.sh')) return [`bash ${p}`];
  if (p.startsWith('skills/') || p.startsWith('agents/') || p.startsWith('commands/') || p.endsWith('.md')) {
    return ['scripts/check-prose', 'scripts/check-paths', 'scripts/check-generated', 'scripts/check-manifest', ...allGateCommands()];
  }
  if (p.startsWith('hooks/') || p.startsWith('plugins/') || p === 'lib/preamble.js' || p === 'lib/plan-state.js') {
    return ['node lib/preamble.test.js', 'node tests/gates/codex-hook-output.test.js', 'node tests/gates/opencode-plugin.test.js'];
  }
  const base = path.basename(p);
  // codex-manifest.test.js is the only gate that reads .codex-plugin/plugin.json
  // and any marketplace.json (it cross-checks them against the Claude manifest);
  // scripts/check-manifest never opens either (Critical 2, task 12 fix round 1).
  if (p.startsWith('.codex-plugin/') || base === 'marketplace.json') {
    return ['node tests/gates/codex-manifest.test.js'];
  }
  if (p.startsWith('.claude-plugin/')) {
    return ['scripts/check-manifest'];
  }
  // Unsure which class a path is in: run scripts/check-all, per the task's own
  // rule. A missed gate is the failure that matters (Critical 1, fix round 1).
  return ['scripts/check-all'];
}

// Keeps only the last occurrence of each command, so the unconditional
// "always last" entry wins over an earlier appearance of the same command
// (e.g. release-version.test.js also showing up inside the gate sweep).
function dedupeKeepLast(commands) {
  const lastIndex = new Map();
  commands.forEach((c, i) => lastIndex.set(c, i));
  return commands.filter((c, i) => lastIndex.get(c) === i);
}

function main() {
  const argv = process.argv.slice(2);
  const dryRun = argv[0] === '--dry-run';
  const paths = dryRun ? argv.slice(1) : argv;

  const raw = paths.flatMap(commandsFor);
  raw.push(LAST);
  const commands = dedupeKeepLast(raw);

  if (dryRun) {
    console.log(commands.join('\n'));
    return;
  }

  for (const cmd of commands) {
    const result = spawnSync(cmd, { shell: true, stdio: 'inherit', cwd: ROOT });
    if (result.status !== 0) process.exit(result.status ?? 1);
  }
}

main();
