#!/usr/bin/env python3
"""Two rules, both checkable against a repository root:

1. ADR 0015's rule: nothing fx tells an agent to write goes into the OS temp
   directory. `/tmp`, `$TMPDIR`, `${TMPDIR`, `%TEMP%`, `os.tmpdir` and
   `tmpdir` are all ways an instruction can point there. Scanned over
   `skills/`, `agents/` and `commands/` only: `scripts/` and `tests/` hold
   test scaffolding, not artifacts a user returns to, and legitimately build
   fixtures under a temp directory: see plan.md's scoping rule.

2. The remote-script rule: nothing fx ships loads a script or stylesheet
   from the internet. Fails on a `<script src=...>` or `<link href=...>`,
   quoted or not, a named, side-effect or dynamic `import`, or a stylesheet
   `@import`, pointing at an `http:`, `https:` or protocol-relative `//`
   URL. A URL named in prose is not a load. Scanned over `skills/`, `agents/`,
   `commands/` and `references/`, except `references/vendor/`: that
   directory holds upstream library code, not an instruction to an agent,
   and its own minified text routinely contains strings that look like a
   remote load. Skipped files are named in the output.

Both rules honour a line tagged `artifact-gate: ok` as a deliberate
exception, declared at the site rather than kept in an allowlist maintained
somewhere else. ADR 0011 records why fx does not maintain allowlists.

    check-artifacts [root]

With no argument, checks this repository. Given a directory, checks that
tree instead, so a test can run the rules against scratch fixtures.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
MARKER = 'artifact-gate: ok'
TMPDIR_PATTERNS = ('/tmp', '$TMPDIR', '${TMPDIR', '%TEMP%', 'os.tmpdir', 'tmpdir')
TMPDIR_AREAS = ('skills', 'agents', 'commands')
REMOTE_AREAS = ('skills', 'agents', 'commands', 'references')
VENDOR_DIR = 'references/vendor'
REMOTE_URL = r'(?:https?:)?//[^\s"\'()<>]+'
# Every form anchors on the syntax that loads, never on a bare URL, so prose
# naming a URL in a sentence is not a hit.
REMOTE_PATTERNS = (
    # a tag's source, quoted or not
    re.compile(r'<script\b[^>]*\bsrc\s*=\s*["\']?' + REMOTE_URL, re.IGNORECASE),
    re.compile(r'<link\b[^>]*\bhref\s*=\s*["\']?' + REMOTE_URL, re.IGNORECASE),
    # a module import: named, side-effect, dynamic
    re.compile(r'\bimport\b[^\n]*\bfrom\s+["\']' + REMOTE_URL, re.IGNORECASE),
    re.compile(r'(?<!@)\bimport\s+["\']' + REMOTE_URL, re.IGNORECASE),
    re.compile(r'\bimport\s*\(\s*["\'`]' + REMOTE_URL, re.IGNORECASE),
    # a stylesheet importing another, through url() or a bare string
    re.compile(r'@import\s+(?:url\(\s*)?["\']?' + REMOTE_URL, re.IGNORECASE),
)


def files(root, areas):
    for area in areas:
        base = root / area
        if not base.exists():
            continue
        for p in sorted(base.rglob('*')):
            if p.is_file():
                yield p


def read_text(path, rel):
    try:
        return path.read_text()
    except UnicodeDecodeError:
        # An image or a font carries no instruction to an agent. Any other
        # read error still fails loudly.
        print(f'skipped, not text: {rel}')
        return None


def tmpdir_hits(root):
    hits = []
    exempted = 0
    for path in files(root, TMPDIR_AREAS):
        rel = str(path.relative_to(root))
        text = read_text(path, rel)
        if text is None:
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if not any(pat in line for pat in TMPDIR_PATTERNS):
                continue
            if MARKER in line:
                exempted += 1
                continue
            hits.append((rel, n))
    return hits, exempted


def remote_hits(root):
    hits = []
    exempted = 0
    skipped_vendor = False
    for path in files(root, REMOTE_AREAS):
        rel = path.relative_to(root).as_posix()
        if rel.startswith(VENDOR_DIR + '/'):
            skipped_vendor = True
            continue
        text = read_text(path, rel)
        if text is None:
            continue
        # Scanned over the whole file, not line by line: a `<script>` or
        # `<link>` tag with its src/href attribute on the next line still
        # matches, since `[^>]*` in REMOTE_PATTERNS already spans a
        # newline. The line reported is where the tag or import starts.
        lines = text.splitlines()
        for pat in REMOTE_PATTERNS:
            for m in pat.finditer(text):
                start = text.count('\n', 0, m.start()) + 1
                end = text.count('\n', 0, m.end()) + 1
                span = '\n'.join(lines[start - 1:end])
                if MARKER in span:
                    exempted += 1
                    continue
                hits.append((rel, start))
    if skipped_vendor:
        print(f'skipped for the remote rule (upstream code): {VENDOR_DIR}/')
    return hits, exempted


def report(hits, label, hint):
    if not hits:
        return True
    by_file = {}
    for rel, n in hits:
        by_file.setdefault(rel, []).append(n)
    print(f'FAIL: {len(hits)} line(s) across {len(by_file)} file(s) {label}')
    for rel, lines in sorted(by_file.items(), key=lambda kv: (-len(kv[1]), kv[0])):
        for n in lines:
            print(f'  {rel}:{n}')
    print()
    print(hint)
    return False


def main():
    root = pathlib.Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else ROOT
    if not root.is_dir() or not any((root / a).is_dir() for a in REMOTE_AREAS):
        print(f'FAIL: not a directory holding any of skills/, agents/, '
              f'commands/ or references/: {root}')
        return 1

    tmp_hits, tmp_exempted = tmpdir_hits(root)
    remote_bad, remote_exempted = remote_hits(root)

    print(f'{tmp_exempted + remote_exempted} line(s) exempted by `{MARKER}`')

    ok = True
    if not tmp_hits:
        print('OK: nothing in skills/, agents/ or commands/ names the OS '
              'temp directory')
    else:
        ok = report(
            tmp_hits, 'name the OS temp directory',
            'Move the write target into docs/plans/<slug>/ if a user returns '
            'to it, or the ephemeral workspace under .fx/ if it is '
            f'regenerable. Tag a deliberate exception with `{MARKER}` on '
            'that line.',
        ) and ok

    if not remote_bad:
        print('OK: nothing outside references/vendor/ loads a script or '
              'stylesheet from a URL')
    else:
        ok = report(
            remote_bad, 'load a script or stylesheet from the internet',
            'Vendor the file into references/vendor/ and load it by a '
            f'relative path instead. Tag a deliberate exception with '
            f'`{MARKER}` on that line.',
        ) and ok

    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
