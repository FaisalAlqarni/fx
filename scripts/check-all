#!/usr/bin/env bash
# The repository's own combined gate: runs every gate and suite the README
# documents, in order, and stops at the first failure, naming it.
#
# check-collisions is deliberately EXCLUDED (Ruling A,
# docs/plans/2026-09-11-fx-audit/tasks/01-machine-facts.md). It reports on
# skill directories under the user's home directory that contest fx's lanes,
# which is machine state outside this repository, not something this
# checkout can fix. It is red at baseline here and cannot be made green from
# inside this repository, so folding it in would make a permanently red gate
# that everyone learns to ignore. It stays a documented, manually run check:
#
#     scripts/check-collisions
set -euo pipefail
cd "$(dirname "$0")/.."

run() {
  local name="$1"; shift
  echo "== $name =="
  if ! "$@"; then
    echo "FAIL: $name"
    exit 1
  fi
}

run check-manifest         scripts/check-manifest
run check-paths            scripts/check-paths
run check-reference-leaves scripts/check-reference-leaves
run check-prose            scripts/check-prose
run check-tool-names       scripts/check-tool-names
run check-interpreters     scripts/check-interpreters
run check-interpreters.test.sh bash tests/gates/check-interpreters.test.sh
run check-prose-explicit-path.sh bash tests/gates/check-prose-explicit-path.sh
run check-artifacts        scripts/check-artifacts
run check-artifacts-remote.sh bash tests/gates/check-artifacts-remote.sh
run check-generated        scripts/check-generated
run agent-model.test.js    node tests/gates/agent-model.test.js
run build-cost.test.js     node scripts/build-cost.test.js
run traps.self-test.js     node tests/fixture-build/hidden/traps.self-test.js
run implementer-heads.test.js node tests/fixture-build/hidden/implementer-heads.test.js
run review-bench-score.test.js node tests/review-bench/score.test.js
run review-bench-build-case.test.js node tests/review-bench/build-case.test.js
run return-contract.test.js node tests/gates/return-contract.test.js
run verdict.test.js        node tests/lane-triggering/verdict.test.js

echo "== make-git-fixture =="
# Path is unique per process ($$ is this script's own PID): a fixed path
# races when two runs of check-all are in flight at once, since
# make-git-fixture starts with `rm -rf` on the path it is given, and one run
# deletes the directory the other is mid-suite against.
FIXTURE_DIR="/tmp/fx-fixture-check-all-$$"
# Removed on every exit, pass or fail, so runs do not pile up in the temp
# directory. make-git-fixture writes only inside the path it is given.
trap 'rm -rf "$FIXTURE_DIR"' EXIT
if ! FIX=$(scripts/make-git-fixture "$FIXTURE_DIR"); then
  echo "FAIL: make-git-fixture"
  exit 1
fi

# make-git-fixture verifies MAIN and WT are a real main checkout and a real
# linked worktree before it echoes them, but nothing between that echo and
# here has checked what actually arrived. A here-string always terminates
# with a newline, so `read` exits 0 whether $FIX held zero, one, or three or
# more tokens: `set -e` cannot catch a wrong shape, only a nonzero exit.
read -r MAIN WT EXTRA <<<"$FIX"
if [ -z "$MAIN" ] || [ -z "$WT" ] || [ -n "${EXTRA:-}" ] \
   || [ ! -d "$MAIN" ] || [ ! -d "$WT" ]; then
  echo "FAIL: make-git-fixture returned an unexpected shape: '$FIX'"
  exit 1
fi

run git-guard.test.js   node lib/git-guard.test.js   "$MAIN" "$WT"
run base-branch.test.js node lib/base-branch.test.js "$MAIN" "$WT"
run heredoc.test.js     node lib/heredoc.test.js     "$MAIN" "$WT"
run plan-state.test.js  node lib/plan-state.test.js
run test-scope.test.js  node scripts/test-scope.test.js
run preamble.test.js    node lib/preamble.test.js
run codex-manifest.test.js  node tests/gates/codex-manifest.test.js
run codex-hook-output.test.js node tests/gates/codex-hook-output.test.js
run user-invoked.test.js    node tests/gates/user-invoked.test.js
run fx-setup-root-check.test.js node tests/gates/fx-setup-root-check.test.js
run plant-roles.test.js     node lib/plant-roles.test.js
run opencode-plugin.test.js  node tests/gates/opencode-plugin.test.js
run description-overlap.test.js node tests/gates/description-overlap.test.js
run no-runtime-addressing.test.js node tests/gates/no-runtime-addressing.test.js
run release-version.test.js node tests/gates/release-version.test.js

run install-opencode        bash tests/install/run.sh opencode
run install-codex           bash tests/install/run.sh codex
run install-claude-code     bash tests/install/run.sh claude-code
run install-home-untouched bash tests/install/home-untouched.test.sh
run conformance-events node tests/conformance/events.test.js
run conformance-runner-isolation bash tests/conformance/runner-isolation.test.sh
run conformance-jail-probe bash tests/conformance/jail-probe.test.sh
run lane-triggering-jail-isolation bash tests/lane-triggering/jail-isolation.test.sh
run lane-triggering-skip-exit bash tests/lane-triggering/skip-exit.test.sh
run conformance-live-exit-code bash tests/conformance/live-exit-code.test.sh
run conformance-plant-codex-roles bash tests/conformance/plant-codex-roles.test.sh
run conformance-merge-opencode-provider bash tests/conformance/merge-opencode-provider.test.sh
run conformance-free-claude-code bash tests/conformance/run.sh claude-code --free
run conformance-free-opencode    bash tests/conformance/run.sh opencode --free
run conformance-free-codex       bash tests/conformance/run.sh codex --free
run ci-pins.test.js node tests/gates/ci-pins.test.js

echo "ALL GREEN"
