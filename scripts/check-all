run system-flow-markdown.test.js node scripts/system-flow-markdown.test.js
run compile-brief.test.js  node skills/fx-implement/scripts/compile-brief.test.js
run brief-size.test.js     node tests/gates/brief-size.test.js
run skill-size.test.js node tests/gates/skill-size.test.js
