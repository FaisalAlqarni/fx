#!/usr/bin/env python3
"""Generate fx's five user-invoked skills and hide them from model
auto-selection on both runtimes.

    scripts/gen-command-skills

Four skills (`fx-critique`, `fx-grill`, `fx-handoff`, `fx-setup`) are
generated from their source command, `commands/<name>.md`: the skill body is
the command body verbatim, with reference depth rewritten. A command cites
`../references/...` and `../agents/...`, correct one level up from
`commands/`; a `SKILL.md` sits one directory deeper, at `skills/<name>/`, so
the same citation needs `../../references/...` and `../../agents/...`.
`scripts/fx-opencode-install` performs this same rewrite for opencode; this
script reuses its approach (frontmatter split, folded-block field reader).

The fifth, `fx-audit`, already has a hand-written `SKILL.md` predating this
script; only its `agents/openai.yaml` sidecar is generated here.

Every one of the five carries `disable-model-invocation: true` in its
`SKILL.md` frontmatter (Claude Code's hiding mechanism) and
`policy.allow_implicit_invocation: false` in `agents/openai.yaml` (Codex's).
Neither mechanism satisfies the other runtime's validator: Codex's bundled
lint rejects `disable-model-invocation: true` outright. That lint is not the
installer, and this script does not work around it by weakening the flag;
see docs/plans/2026-09-21-multi-harness/tasks/07-hide-the-audit-lane.md.

Idempotent: running this twice produces byte-identical output.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
COMMANDS = ROOT / "commands"
SKILLS = ROOT / "skills"

# A command cites `../references/x` and `../agents/x`, one level up from
# `commands/`. A generated `skills/<name>/SKILL.md` sits one directory
# deeper, so every such citation needs one more `../`.
DEEPEN = re.compile(r"\.\./(references|agents)/")

COMMAND_DERIVED = ["fx-critique", "fx-grill", "fx-handoff", "fx-setup"]

SOURCE_NOTE = "# generated by scripts/gen-command-skills from {source}: edit there, not here"


def split_frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
    if not m:
        sys.exit("no frontmatter found")
    return m.group(1), m.group(2)


def field(fm, key):
    """Read a scalar or a YAML '>' folded block, as fx-opencode-install does."""
    m = re.search(rf"^{key}:\s*>\s*\n((?:[ \t]+.*\n?)+)", fm, re.M)
    if m:
        return " ".join(l.strip() for l in m.group(1).splitlines() if l.strip())
    m = re.search(rf"^{key}:[ \t]*(.+)$", fm, re.M)
    return m.group(1).strip() if m else None


def skill_md(name, source, description, body, argument_hint=None):
    hint_line = f"argument-hint: {argument_hint}\n" if argument_hint else ""
    return (
        "---\n"
        f"name: {name}\n"
        "description: >\n"
        f"  {description}\n"
        f"{hint_line}"
        "disable-model-invocation: true\n"
        f"{SOURCE_NOTE.format(source=source)}\n"
        "---\n"
        f"{body}"
    )


def openai_yaml(name, source, short_description):
    return (
        f"{SOURCE_NOTE.format(source=source)}\n"
        "interface:\n"
        f'  display_name: "{name}"\n'
        f'  short_description: "{short_description}"\n'
        "policy:\n"
        "  allow_implicit_invocation: false\n"
    )


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(f"wrote {path.relative_to(ROOT)}")


def main():
    for name in COMMAND_DERIVED:
        cmd_path = COMMANDS / f"{name}.md"
        source = f"commands/{name}.md"
        fm, body = split_frontmatter(cmd_path.read_text())
        description = field(fm, "description") or name
        argument_hint = field(fm, "argument-hint")
        deepened_body = DEEPEN.sub(r"../../\1/", body)

        skill_dir = SKILLS / name
        write(skill_dir / "SKILL.md",
              skill_md(name, source, description, deepened_body, argument_hint))
        write(skill_dir / "agents" / "openai.yaml", openai_yaml(name, source, description))

    # fx-audit's SKILL.md is hand-written and predates this script: only its
    # sidecar is generated.
    audit_skill = SKILLS / "fx-audit" / "SKILL.md"
    audit_fm, _ = split_frontmatter(audit_skill.read_text())
    audit_description = field(audit_fm, "description") or "fx-audit"
    write(SKILLS / "fx-audit" / "agents" / "openai.yaml",
          openai_yaml("fx-audit", "skills/fx-audit/SKILL.md", audit_description))


if __name__ == "__main__":
    main()
