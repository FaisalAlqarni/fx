#!/usr/bin/env python3
"""Validate .claude-plugin/plugin.json before an install tries to.

    scripts/check-manifest [path]      default: the repository root

Checks:
  1. No key outside the set observed in working plugin manifests.
  2. Every declared `skills`/`commands` path exists on disk.
  3. Every declared skill directory holds a SKILL.md.
  4. Convention-discovered directories exist if their content does.
  5. A declared component key still reaches its conventional default
     location, per ADR 0017. The one exception is `commands: []`, allowed
     while every commands/*.md has the skill generated from it.
"""
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent

# Union of keys seen in plugins that install successfully. `agents` and
# `hooks` are convention-discovered (ADR 0009: `./agents/`, `./hooks/hooks.json`)
# but declaring either is not an error: measured 2026-09-21 against Claude Code
# 2.1.278, a manifest declaring both passes `claude plugin validate` with only
# an unrelated author warning. See ADR 0017.
ALLOWED = {
    "name", "version", "description", "author", "homepage", "repository",
    "license", "keywords", "skills", "commands", "agents", "hooks",
    "mcpServers", "userConfig",
}
CONVENTION_ONLY = {"agents", "hooks"}

# Component keys whose declaration REPLACES the conventional default location
# it would otherwise scan, rather than adding to it (ADR 0017). `skills` is
# the documented exception: it always adds to `./skills/` rather than
# replacing it, so it carries no orphan risk and is not listed here.
REPLACES_DEFAULT = {
    "agents": "agents",
    "commands": "commands",
    "hooks": "hooks/hooks.json",
}


def main():
    root = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT
    manifest = root / ".claude-plugin" / "plugin.json"

    errors = []
    d = json.loads(manifest.read_text())

    for k in d:
        if k not in ALLOWED:
            errors.append(f"unknown key `{k}`: not seen in any working manifest")

    for key in ("skills", "commands"):
        for entry in d.get(key, []):
            p = (root / entry.lstrip("./")).resolve()
            if not p.exists():
                errors.append(f"{key}: declared path does not exist: {entry}")
            elif key == "skills" and p.is_dir() and not (p / "SKILL.md").exists():
                errors.append(f"skills: {entry} has no SKILL.md")

    hooks = d.get("hooks")
    if hooks and not (root / hooks.lstrip("./")).exists():
        errors.append(f"hooks: file does not exist: {hooks}")

    # A declared component key must still reach the default location it
    # replaces, or that location's files go silently unscanned. ADR 0017: the
    # hazard is not a failed load, it is a default the declaration orphans.
    for key, default_rel in REPLACES_DEFAULT.items():
        if key not in d:
            continue
        default_path = (root / default_rel).resolve()
        if not default_path.exists():
            continue
        declared = d[key]
        # `commands: []` is fx's deliberate opt-out (final review I5):
        # commands/ is the source scripts/gen-command-skills generates skills
        # from, and registering both listed every such lane twice. Nothing is
        # orphaned only while every command has its generated skill.
        if key == "commands" and declared == []:
            for cmd in sorted(default_path.glob("*.md")):
                skill = root / "skills" / cmd.stem / "SKILL.md"
                note = f"generated by scripts/gen-command-skills from commands/{cmd.name}"
                if not skill.exists() or note not in skill.read_text():
                    errors.append(
                        f"commands: [] leaves commands/{cmd.name} unregistered and "
                        f"skills/{cmd.stem}/SKILL.md is not generated from it: "
                        f"run scripts/gen-command-skills")
            continue
        entries = declared if isinstance(declared, list) else [declared]
        resolved = {(root / e.lstrip("./")).resolve() for e in entries}
        if default_path not in resolved:
            errors.append(
                f"{key}: declares {declared!r} without './{default_rel}', "
                f"so the default location no longer gets scanned and its "
                f"files are orphaned")

    # Convention directories: present on disk, declared or not either way.
    for conv in CONVENTION_ONLY:
        dirp = root / conv
        if dirp.is_dir():
            n = len(list(dirp.glob("*.md")))
            state = "declared" if conv in d else "undeclared"
            print(f"convention: ./{conv}/ holds {n} file(s), {state}")

    if errors:
        print(f"\nFAIL: {len(errors)} manifest problem(s)")
        for e in errors:
            print(f"  {e}")
        return 1

    print(f"OK: manifest valid: {len(d.get('skills', []))} skills declared, "
          f"{len(d.get('commands', []))} command path(s), hooks wired")
    return 0


if __name__ == "__main__":
    sys.exit(main())
