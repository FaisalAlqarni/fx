#!/usr/bin/env bash
# Compiles every TypeScript source under src/ to its committed path, with one
# esbuild call per file: plugins, hooks and the opencode installer require
# lib/ modules by literal .js path, so nothing is bundled, and each output's
# header names its own source. docs/adr/0046-fx-sources-are-typescript.md.
#
#     scripts/build [--out <dir>]     (default: the repository root)
set -euo pipefail
OUT=""
if [ "${1:-}" = "--out" ]; then
  mkdir -p "${2:?scripts/build: --out needs a directory}"
  OUT="$(cd "$2" && pwd)"
fi
cd "$(dirname "$0")/.."
OUT="${OUT:-$PWD}"

ESBUILD=node_modules/.bin/esbuild
if [ ! -x "$ESBUILD" ]; then
  echo "scripts/build: run npm ci first" >&2
  exit 1
fi

n=0
while IFS= read -r -d '' src; do
  n=$((n + 1))
  rel="${src#src/}"
  platform=node format=cjs mode=644 out="${rel%.ts}.js"
  case "$rel" in
    *.cts) out="${rel%.cts}.cjs" ;;
    # Extensionless node scripts; scripts/test-scope keeps the same list.
    scripts/build-cost.ts|scripts/test-scope.ts|skills/fx-implement/scripts/compile-brief.ts)
      out="${rel%.ts}" mode=755 ;;
    plugins/*.ts|index.ts) format=esm ;;
    skills/fx-brainstorm/scripts/helper.ts) platform=browser format=iife ;;
  esac
  target=()
  [ "$platform" = node ] && target=(--target=node20)
  mkdir -p "$(dirname "$OUT/$out")"
  "$ESBUILD" "$src" --platform="$platform" --format="$format" ${target[@]+"${target[@]}"} \
    --outfile="$OUT/$out" --log-level=warning \
    "--banner:js=// generated from $src by scripts/build: edit there, not here"
  chmod "$mode" "$OUT/$out"
done < <(find src -type f \( -name '*.ts' -o -name '*.cts' \) ! -name '*.d.ts' -print0 | sort -z)
# find runs in a process substitution, so its failure shows only as nothing built.
if [ "$n" -eq 0 ]; then
  echo "scripts/build: built no files from src/" >&2
  exit 1
fi
